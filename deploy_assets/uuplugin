#!/bin/sh
# gd-iptv-panel launcher & watchdog for ZTE router

mkdir -p /tmp/gd-iptv-panel

# 自动挂载前端 4th Tab 独立开关
if [ -f /UUPlugin/index_patched.html ]; then
    cp -f /UUPlugin/index_patched.html /tmp/index_patched.html
    umount /kmodule/home/httpd/public/jquery/static/index.html 2>/dev/null
    mount --bind /tmp/index_patched.html /kmodule/home/httpd/public/jquery/static/index.html
fi

start_panel() {
    if ! pgrep gd-iptv-panel >/dev/null 2>&1; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting gd-iptv-panel..." >> /tmp/gd-iptv-panel/watchdog.log
        RUST_LOG=info /UUPlugin/gd-iptv-panel \
            -c /UUPlugin/config.json \
            -p /tmp/gd-iptv-panel/panel.pid >> /tmp/gd-iptv-panel/panel.log 2>&1 &
    fi
}

start_panel

while true; do
    sleep 30
    start_panel

    # 日志防爆保护：超过 200KB 自动重置，确保内存盘永远不被占满
    if [ -f /tmp/gd-iptv-panel/panel.log ] && [ $(wc -c < /tmp/gd-iptv-panel/panel.log) -gt 204800 ]; then
        : > /tmp/gd-iptv-panel/panel.log
    fi
    if [ -f /tmp/gd-iptv-panel/watchdog.log ] && [ $(wc -c < /tmp/gd-iptv-panel/watchdog.log) -gt 102400 ]; then
        : > /tmp/gd-iptv-panel/watchdog.log
    fi
done
